{
  "name": "orbital-congestion-simulator-premium",
  "private": true,
  "version": "1.2.0",
  "description": "Real-time 3D visualization of Earth orbit congestion with close-approach alerts and amateur-radio frequencies.",
  "author": "Muhammet (https://github.com/muhammet842)",
  "license": "MIT",
  "homepage": "https://orbital-congestion.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhammet842/orbital-congestion-simulator-premium.git"
  },
  "bugs": {
    "url": "https://github.com/muhammet842/orbital-congestion-simulator-premium/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "fetch-tle": "node scripts/fetch-tle.mjs",
    "pull-data": "node scripts/pull-data.mjs --force",
    "prebuild": "node scripts/pull-data.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "check:i18n": "node scripts/check-i18n-parity.mjs",
    "screenshot": "npm run build && node scripts/capture-readme-screenshot.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/three": "^0.186.0",
    "jsdom": "^30.1.3",
    "typescript": "~7.0.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "magvar": "^2.2.0",
    "satellite.js": "^7.1.0",
    "three": "^0.186.1"
  }
}
